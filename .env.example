# Bind the container port only to this host interface. Change to your LAN IP deliberately.
BIND_IP=127.0.0.1
PORT=3000
DATABASE_PATH=/data/jobs.db
API_TOKEN=replace-with-a-long-random-token
AI_SECRETS_KEY=replace-with-a-different-long-random-secret
CANDIDATE_PROFILE_PATH=/app/.ai/nikolai_semenov_master_profile_v1.json
